{
  "name": "webgpu-graph-vis",
  "version": "0.1.0",
  "private": true,
  "description": "3D graph visualization in the browser with three.js WebGPU/TSL: GPU force-directed layout, hierarchical edge bundling, glow rendering. Visual style after ImsvGraphVis (Kwon et al., TVCG 2016).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:convert": "node scripts/convert-imsv.mjs",
    "data:generate": "node scripts/generate.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "shot": "node scripts/shot.mjs"
  },
  "keywords": ["webgpu", "three.js", "tsl", "graph", "force-directed", "edge-bundling", "visualization"],
  "license": "MIT",
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  }
}
